---
import { getCollection, render } from 'astro:content';
import Sheet from '../../layouts/Sheet.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---
<Sheet title={`${note.data.title} — Toni Siik`} description={note.data.description}>
  <section class="sheet-page"><div class="wrap">
    <a class="backlink top" href="/#notes">← Back to the drawing set</a>
    <div class="doc-head">
      <div class="sheet-tag"><b>NOTE</b> — {note.data.category ?? 'Field note'}</div>
      {note.data.tags && (
        <div class="doc-tags">{note.data.tags.map((t) => (<span class="mini"><span class="edge"></span>{t}</span>))}</div>
      )}
    </div>
    <article class="doc"><Content /></article>
    <a class="backlink" href="/#notes">← Back to the drawing set</a>
  </div></section>
</Sheet>
