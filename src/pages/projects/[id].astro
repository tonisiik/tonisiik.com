---
import { getCollection, render } from 'astro:content';
import Sheet from '../../layouts/Sheet.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Sheet title={`${project.data.title} — Toni Siik`} description={project.data.description}>
  <section class="sheet-page"><div class="wrap">
    <div class="doc-head">
      <div class="sheet-tag"><b>DETAIL</b> — {project.data.category ?? 'Case study'}</div>
      {project.data.description && (
        <p class="note" style="margin-top:12px;max-width:64ch">{project.data.description}</p>
      )}
      {project.data.tags && (
        <div class="doc-tags">{project.data.tags.map((t) => (<span class="mini"><span class="edge"></span>{t}</span>))}</div>
      )}
    </div>
    <article class="doc"><Content /></article>
    <a class="backlink" href="/#work">← Back to the drawing set</a>
  </div></section>
</Sheet>
