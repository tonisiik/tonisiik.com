---
import { getCollection } from 'astro:content';
import Sheet from '../../layouts/Sheet.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => new Date(b.data.pubdate || 0).valueOf() - new Date(a.data.pubdate || 0).valueOf()
);
---
<Sheet title="Case Studies — Toni Siik" description="Selected case studies and engineering deployments by Toni Siik.">
  <section class="sheet-page"><div class="wrap">
    <div class="plate-head">
      <div class="sheet-tag"><b>INDEX</b> — Drawing Set</div>
      <h2 class="plate-title">Case <span class="u">studies</span></h2>
    </div>
    <div class="proj-grid">
      {projects.map((p, i) => (
        <a class="proj" href={`/projects/${p.id}`}><span class="edge"></span>
          <div class="top"><span class="code">{p.data.category ?? 'Case study'}</span><span class="id">{String(i + 1).padStart(2, '0')}</span></div>
          <h4>{p.data.title}</h4>
          <p class="note">{p.data.description}</p>
        </a>
      ))}
    </div>
  </div></section>
</Sheet>
