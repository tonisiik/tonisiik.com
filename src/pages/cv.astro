---
import Sheet from '../layouts/Sheet.astro';

const experience = [
  {
    period: '2022 — Present', current: true,
    role: 'Production Engineer / Foundry Expert (2024–present) · Foundry Manager (2022–2024)',
    org: 'Georg Fischer JRG AG · Sissach, CH',
    bullets: [
      'Root-caused a metallurgical defect responsible for <strong>~CHF 5M</strong> in scrap that 5–6 years of prior work had not — multi-source data program (5 systems, ~2,000 charges), Design of Experiments and SEM/EDX; drove a zero-CAPEX process-policy change + production fix to curb recurrence; replaced subjective inspection with quantitative acceptance criteria.',
      'Built production ML &amp; computer-vision systems (scrap forecasting, automated grain-size measurement) and a reproducibility / data-governance platform.',
      'Plant-wide data management &amp; analysis; automated core-shop vision; corrected false SAP cost models; defined the DFM review; 5S, Kanban (~30% lead-time gain), safety planning.',
    ],
  },
  {
    period: '2019 — 2022',
    role: 'Technical Director / Head of Foundry',
    org: 'Metallgiesserei Wilhelm Funke GmbH · Alfeld (Leine), DE',
    bullets: [
      'Modernized the foundry&apos;s engineering — a <strong>simulation-first casting-design</strong> approach (Flow3D) and <strong>data-based process development</strong>; streamlined prototyping to sub-5-day 3D-printed moulds.',
      'The new method lifted <strong>+50% yield, −60% chills</strong> and root-caused magnesium &amp; copper-alloy defects.',
      'Direct design support to Rimac on next-gen electric engines.',
    ],
  },
  {
    period: '2015 — 2019',
    role: 'Senior Project Engineer / Simulation Specialist',
    org: 'Nemak Wernigerode GmbH · DE',
    bullets: [
      'Rescued an engine-block launch by root-causing hot tearing with process-parameter changes alone — avoided a costly tooling change.',
      'Built a predictive material-property tool from <strong>10,000+ tensile bars</strong> to secure SOP; created an SQL framework to leverage process data across the chain.',
    ],
  },
  {
    period: '2011 — 2015',
    role: 'Product Development Engineer / Lead Design Engineer',
    org: 'Componenta · Helsinki, FI',
    bullets: [
      'Supported a <strong>300,000+ t/yr</strong> foundry network; led 10-tonne wind-turbine hubs &amp; marine castings (clients incl. Wärtsilä).',
      'Cut <strong>scrap 50%</strong> via simulation + process-data analysis; calibrated MAGMAsoft to high defect/property correlation.',
    ],
  },
];

const skills = [
  { area: 'Data Science', items: ['Causal inference', 'Design of Experiments', 'SPC', 'SHAP', 'XGBoost / Random Forest', 'CV & deep learning'] },
  { area: 'Casting & Process', items: ['Gravity SPM / Rotacast®', 'Sand casting — Fe, steel, non-ferrous, Mg, Al', '3D-printed sand-mould prototyping', 'LPDC process simulation (research)', 'DFM & castability'] },
  { area: 'Engineering', items: ['Python · SQL', 'Parquet · DuckDB · Polars', 'FastAPI', 'Electron / React', 'MCP servers', 'PyTorch · Cellpose-SAM'] },
  { area: 'Domain', items: ['Foundry & metallurgy', 'Quality engineering', 'ERP / SAP master data', 'Casting simulation', 'Defect & scrap analysis', 'Measurement gates'] },
  { area: 'Method & Quality', items: ['DMAIC · Lean Six Sigma', 'ISO 9001', '5S · shopfloor mgmt', 'FMEA', 'CAPEX projects', 'Stakeholder mgmt'] },
];

const achievements = [
  { v: '5M', u: 'CHF', l: 'Scrap defect root-caused' },
  { v: '50', u: '%', l: 'Scrap-rate reduction' },
  { v: '80', u: '%', l: 'Prototype-effort cut' },
  { v: '10k', u: '+', l: 'Tensile bars modelled' },
];
---
<Sheet title="Toni Siik — CV" description="Curriculum vitae of Toni Siik — manufacturing data scientist & foundry engineer.">
  <section class="sheet-page"><div class="wrap">

    <div class="cv-head"><span class="edge"></span>
      <div class="sheet-tag"><b>SHEET 08</b> — Curriculum Vitae</div>
      <h1 class="cv-name" style="margin-top:10px">Toni Siik</h1>
      <div class="cv-role">Lead Manufacturing Data Scientist · Quality &amp; Process Intelligence</div>
      <div class="cv-contact">
        <a href="mailto:toni.siik@gmail.com">toni.siik@gmail.com</a><span>·</span>
        <a href="https://www.linkedin.com/in/tonisiik" target="_blank" rel="noopener">/in/tonisiik</a><span>·</span>
        <span>Trimbach, Switzerland</span><span>·</span>
        <a href="https://www.tonisiik.com">tonisiik.com</a>
      </div>
      <a class="cv-dl" href="/Toni-Siik-CV.pdf" download style="position:relative;display:inline-block;margin-top:16px;padding:9px 16px;text-decoration:none;font-weight:600;letter-spacing:.02em"><span class="edge"></span>Download PDF ↓</a>
    </div>

    <div class="cv-section">
      <div class="sheet-tag"><b>00</b> — Summary</div>
      <p class="note" style="margin-top:12px;max-width:76ch">Foundry engineer who leads production and turns its data into measured change. 14+ years across European casting operations (automotive, marine, aerospace) — from running a foundry as Technical Director to architecting the analytics that root-caused a ~CHF 5M scrap defect unsolved for 5–6 years. A rare full stack: production leadership + metallurgy + applied data science.</p>
    </div>

    <div class="cv-section">
      <div class="about-stats" style="grid-template-columns:repeat(auto-fit,minmax(130px,1fr))">
        {achievements.map((a) => (
          <div class="statbox"><span class="edge"></span><div class="n">{a.v}<span class="u">{a.u}</span></div><div class="l">{a.l}</div></div>
        ))}
      </div>
    </div>

    <div class="cv-section">
      <div class="sheet-tag"><b>01</b> — Experience</div>
      <div class="timeline" style="margin-top:22px">
        {experience.map((e) => (
          <div class={`tl${e.current ? ' current' : ''}`}><span class="stn"><span class="edge"></span></span>
            <div class="date">{e.period}</div>
            <div class="role">{e.role}</div>
            <div class="org">{e.org}</div>
            <ul class="cv-list">{e.bullets.map((b) => (<li set:html={b}></li>))}</ul>
          </div>
        ))}
      </div>
    </div>

    <div class="cv-section cv-twocol">
      <div>
        <div class="sheet-tag"><b>02</b> — Education &amp; Certifications</div>
        <div class="timeline" style="margin-top:18px">
          <div class="tl"><span class="stn"><span class="edge"></span></span>
            <div class="date">2005 — 2011</div>
            <div class="role">MSc &amp; BSc</div>
            <div class="org">Metal Materials &amp; Manufacturing · Tampere University of Technology, FI</div>
          </div>
          <div class="tl"><span class="stn"><span class="edge"></span></span>
            <div class="date">2011</div>
            <div class="role">MSc Thesis — Verification of Low-Pressure Die Casting Simulation Results</div>
            <div class="org">Tampere University of Technology · public, 544 downloads</div>
          </div>
          <div class="tl"><span class="stn"><span class="edge"></span></span>
            <div class="date">2026</div>
            <div class="role">Lean Six Sigma Green Belt</div>
            <div class="org">Completed</div>
          </div>
        </div>
      </div>
      <div>
        <div class="sheet-tag"><b>03</b> — Languages</div>
        <ul class="cv-list" style="margin-top:18px">
          <li><strong>Finnish</strong> — native</li>
          <li><strong>English</strong> — native</li>
          <li><strong>German</strong> — fluent</li>
          <li><strong>Swedish</strong> — moderate</li>
          <li><strong>Dutch</strong> — moderate</li>
        </ul>
        <div class="sheet-tag" style="margin-top:28px"><b>★</b> — Recognition</div>
        <p class="note" style="margin-top:12px">Featured interview — Valimoviesti 1/2026 (Finnish Foundrymen's Association).</p>
      </div>
    </div>

    <div class="cv-section">
      <div class="sheet-tag"><b>04</b> — Capabilities</div>
      <div class="bom" style="margin-top:20px"><div class="bom-grid">
        {skills.map((s) => (
          <div class="bom-col"><span class="edge"></span>
            <h3>{s.area}</h3>
            <ul>{s.items.map((i) => (<li>{i}</li>))}</ul>
          </div>
        ))}
      </div></div>
    </div>

    <div class="cv-section">
      <div class="sheet-tag"><b>05</b> — Beyond Work</div>
      <ul class="cv-list" style="margin-top:14px">
        <li>Floorball coach — junior team</li>
        <li>Trail running &amp; fastpacking</li>
        <li>Internationally rooted — lived in Finland, USA, Netherlands, Germany &amp; Switzerland</li>
      </ul>
    </div>

    <a class="backlink" href="/">← Return to Sheet 01</a>
  </div></section>
</Sheet>
