---
// Reusable blueprint "sheet" chrome for sub-pages (CV, project details, index).
// Mirrors the home page's drawing-set styling: topbar + footer + stamp,
// loads /blueprint.css and /blueprint.js (route builder no-ops when absent).
interface Props { title?: string; description?: string; }
const {
  title = 'Toni Siik — Manufacturing Data Scientist',
  description = 'Toni Siik — manufacturing data scientist. Quality & process intelligence: foundry metallurgy + ERP/SAP + data science.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script is:inline>document.documentElement.className += ' js';</script>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" href="/favicon.ico">
<link rel="stylesheet" href="/blueprint.css">
</head>
<body>

<header class="topbar" id="topbar">
  <a class="id" href="/">T. SIIK</a>
  <nav class="idx">
    <a href="/#about">02·About</a>
    <a href="/#work">04·Work</a>
    <a href="/#path">05·Path</a>
    <a href="/#contact">07·Contact</a>
    <a href="/cv">08·CV</a>
  </nav>
</header>

<main>
  <slot />
</main>

<footer class="foot">
  <span>© <span id="year"></span> Toni Siik · Manufacturing Data Science</span>
  <span><a href="/">← Return to Sheet 01</a></span>
</footer>

<div class="stamp">DWG. <b>TS-2026</b> · NTS · <span id="stamp-year"></span></div>

<script is:inline src="/blueprint.js"></script>
</body>
</html>
